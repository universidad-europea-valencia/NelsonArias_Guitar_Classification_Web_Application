# Backend Configuration
PYTHONUNBUFFERED=1
MODEL_CACHE_SIZE=2
MODELS_PATH=/app/models
FRONTEND_URL=http://localhost:3000

# API Configuration
API_TITLE=Guitar Classification API
API_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Model Configuration
PRIMARY_MODEL_NAME=best_guitar_model.keras
PRIMARY_MODEL_THRESHOLD=0.5
ALTERNATIVE_MODEL_NAME=best_transfer_model.keras
ALTERNATIVE_MODEL_THRESHOLD=0.5

# Image Processing
IMAGE_MAX_SIZE=4194304
IMAGE_ALLOWED_FORMATS=jpg,jpeg,png,gif,bmp
IMAGE_TARGET_SIZE=224,224

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
